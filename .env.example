# Postgres. docker compose sets this for you; set it yourself when running pnpm --filter web dev.
DATABASE_URL=postgres://creator_agent:creator_agent@localhost:5433/creator_agent

# The public origin of this instance. Must match the OAuth redirect you registered.
APP_URL=http://localhost:3000

# Development only: hosts other than localhost you open the dev server at, comma separated
# (for example 192.168.1.20,devbox.example.net). Without them Next blocks its dev scripts there.
ALLOWED_DEV_ORIGINS=

# true on a self-hosted instance: removes the limit of two questions per account per 24 hours.
# docker compose defaults it to true; the hosted instance sets false.
SELF_HOSTED=true

# Clerk (https://clerk.com). Create an application and paste its two keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AnyAPI (https://getanyapi.com). The key free questions run on.
ANYAPI_HOUSE_API_KEY=
# Surplus Intelligence. The key the models run on.
SURPLUS_API_KEY=

# Connecting AnyAPI wallets, optional: without a client id every account is on the free tier.
# Printed by: pnpm --filter web anyapi:register
ANYAPI_OAUTH_CLIENT_ID=
# 32 random bytes, base64; required with ANYAPI_OAUTH_CLIENT_ID. Encrypts the stored AnyAPI tokens.
# Generate one with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# The longest question accepted, in characters. Required; docker compose defaults it to 500.
MAX_QUESTION_CHARS=500

# Questions researched at once across the whole instance; the next asker is told to try again in a
# few minutes. 8 is the code's default, derived in web/src/server/config.ts.
RUNS_IN_FLIGHT=8

# Daily ceilings on what the house keys spend, in USD, by UTC day. Once either is reached,
# free questions are refused until the next UTC day; the model ceiling also refuses questions
# paid from a connected wallet, whose data the house does not pay for.
HOUSE_DATA_CAP_USD_PER_DAY=50
HOUSE_LLM_CAP_USD_PER_DAY=10
